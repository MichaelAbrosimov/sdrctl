# Per-instance environment for rtl-tcp@<device-id>.service.
# Install as /etc/sdrctl/devices/<device-id>.env (e.g. rtl-sdr-01.env).
LISTEN_ADDR=0.0.0.0
PORT=1234
# rtl_tcp selects the dongle by index. Keep indexes stable by assigning unique
# serials with rtl_eeprom, then verify the mapping with `sdrctl device <id>`.
DEVICE_ARGS=-d 0
