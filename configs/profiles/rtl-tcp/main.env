# rtl-tcp@main: the IQ transport this node normally runs (OpenWebRX on pi5).
# Installed as /etc/sdrctl/profiles/rtl-tcp/main.env
#
# A profile may also pin WHICH dongle it uses - device selection is just
# another parameter. With several dongles, give each its own profile and
# pin it here rather than inventing a second instance axis.
LISTEN_ADDR=0.0.0.0
PORT=1234
DEVICE_ARGS=-d 0
