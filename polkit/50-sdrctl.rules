// No-sudo SDR control for the operator user (michael).
//
// manage-units (start/stop/restart/reset-failed) carries the unit name and
// is scoped strictly to the SDR units. manage-unit-files (enable/disable)
// carries NO details at all in systemd's polkit request (verified on
// systemd 257 / polkitd 126), so per-unit scoping is impossible there —
// it is granted wholesale. Accepted trade-off on this single-operator
// appliance: michael is a sudoer anyway, and creating/modifying unit files
// still requires root; this only covers enabling/disabling existing units.
polkit.addRule(function (action, subject) {
    if (subject.user != "michael")
        return polkit.Result.NOT_HANDLED;

    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var allowed = ["rtl-tcp.service", "rtl-433.service", "spyserver.service"];
        if (unit && allowed.indexOf(unit) >= 0)
            return polkit.Result.YES;
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id == "org.freedesktop.systemd1.manage-unit-files")
        return polkit.Result.YES;

    return polkit.Result.NOT_HANDLED;
});
