# Single-device rtl_tcp unit (deploy-time example).
# Install: cp systemd/rtl-tcp.service /etc/systemd/system/
#
# Mode semantics live in systemd, not in sdrctl code:
#   Conflicts=   one dongle = one active SDR mode
#   Restart=     crash recovery (sdrctl does not supervise)
#   enabled      desired mode (sdrctl mode set = enable/disable --now)
[Unit]
Description=rtl_tcp SDR server
After=network-online.target
Wants=network-online.target
Conflicts=rtl-433.service spyserver.service
StartLimitBurst=3
StartLimitIntervalSec=120

[Service]
Type=simple
# Defaults below; override without editing the unit by creating
# /etc/sdrctl/rtl-tcp.env (same variables as configs/device.env.example).
# Keep PORT in sync with services.rtl-tcp.port in /etc/sdrctl/config.yaml —
# sdrctl only displays that port, the unit is what actually binds it.
Environment=LISTEN_ADDR=0.0.0.0 PORT=1234 DEVICE_ARGS=
EnvironmentFile=-/etc/sdrctl/rtl-tcp.env
ExecStart=/usr/bin/rtl_tcp -a ${LISTEN_ADDR} -p ${PORT} ${DEVICE_ARGS}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
